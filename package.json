{
  "name": "yolainfohub-backend",
  "version": "1.0.0",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/navigationDetailProfiles.test.js",
    "build": "npm install && echo 'Build complete'",
    "import-schools": "node scripts/import-schools.js",
    "import-schools:write": "node scripts/import-schools.js --write",
    "import-professionals": "node scripts/import-professionals.js",
    "import-professionals:write": "node scripts/import-professionals.js --write",
    "seed-restaurant-media": "node scripts/seed-restaurant-media.js",
    "seed-restaurant-media:force": "node scripts/seed-restaurant-media.js --force",
    "initialize-school-profiles": "node scripts/initialize-school-profiles.js",
    "initialize-university-profiles": "node scripts/initialize-university-profiles.js",
    "initialize-technical-profiles": "node scripts/initialize-technical-profiles.js",
    "initialize-learning-profiles": "node scripts/initialize-learning-profiles.js",
    "initialize-healthcare-profiles": "node scripts/initialize-healthcare-profiles.js",
    "initialize-navigation-detail-profiles": "node scripts/initialize-navigation-detail-profiles.js",
    "initialize-navigation-detail-profiles:write": "node scripts/initialize-navigation-detail-profiles.js --write",
    "initialize-navigation-template-profiles": "node scripts/initialize-navigation-template-profiles.js",
    "initialize-navigation-template-profiles:write": "node scripts/initialize-navigation-template-profiles.js --write",
    "initialize-navigation-demo-profiles": "node scripts/initialize-navigation-demo-profiles.js",
    "initialize-navigation-demo-profiles:write": "node scripts/initialize-navigation-demo-profiles.js --write",
    "import-navigation-places": "node scripts/import-navigation-places.js",
    "import-navigation-places:write": "node scripts/import-navigation-places.js --write",
    "predeploy": "npm run build",
    "deploy": "netlify deploy --prod",
    "render-deploy": "echo 'Render deployment handled via render.yaml'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.1",
    "express-rate-limit": "^6.11.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.2.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.8.7",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.1",
    "sharp": "^0.34.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
